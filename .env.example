# ─────────────────────────────────────────────────────────────────
#  VARIABLES DE ENTORNO — Indians Sistema Textil (backIndians)
#  Copiar este archivo a .env para desarrollo local.
#  En Railway configurar cada variable en el dashboard (no subir .env).
# ─────────────────────────────────────────────────────────────────

# Servidor
PORT=3000
# En Railway: NODE_ENV=production  (configurar en Variables del proyecto)
NODE_ENV=development

# ── Base de datos MySQL ───────────────────────────────────────────
# En Railway: usar los datos del plugin MySQL de Railway
#   DB_HOST    → desde Railway MySQL → Connect → Host
#   DB_PORT    → desde Railway MySQL → Connect → Port
#   DB_NAME    → desde Railway MySQL → Connect → Database
#   DB_USER    → desde Railway MySQL → Connect → Username
#   DB_PASSWORD → desde Railway MySQL → Connect → Password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=textil_db
DB_USER=root
DB_PASSWORD=secret

# ── JWT — IMPORTANTE: usar valores únicos y seguros en producción ─
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERAR_VALOR_UNICO_MINIMO_64_BYTES
JWT_REFRESH_SECRET=GENERAR_VALOR_UNICO_MINIMO_64_BYTES_DIFERENTE
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary ────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# ── Frontend (CORS) ───────────────────────────────────────────────
# En Railway: URL del deploy del frontend (ej: https://indians-front.vercel.app)
FRONTEND_URL=http://localhost:5173

# ── Emails de la TIENDA (Resend) — REQUERIDO en producción ───────
# El sistema de emails de la tienda (verificación de cuenta, reset de contraseña,
# confirmación de pedido y facturas) usa Resend, NO SMTP.
# Crear la API key en https://resend.com/api-keys y verificar el dominio del remitente.
# Sin RESEND_API_KEY los emails de la tienda NO se envían.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@tudominio.com

# ── SMTP (recuperación de contraseña del panel admin) — opcional ──
# Solo lo usa el reset de contraseña de usuarios internos (mailer.ts). La tienda usa Resend.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password_de_google
SMTP_FROM="Sistema Textil <tu_email@gmail.com>"

# ── Cloudflare Turnstile (CAPTCHA anti-bot en el registro de compradores) ──
# Crear un sitio gratis en https://dash.cloudflare.com/?to=/:account/turnstile
# Copiar el "Secret Key" acá y el "Site Key" en frontIndians/.env (VITE_TURNSTILE_SITE_KEY).
# Si se deja vacío, la verificación se OMITE (modo graceful, registro sin CAPTCHA).
TURNSTILE_SECRET_KEY=

# ── Flags de seguridad (testing) ─────────────────────────────────
# RATE_LIMIT_DISABLED=1 desactiva rate-limit y CAPTCHA (usar SOLO en tests de carga locales).
# RATE_LIMIT_DISABLED=

# ── Jobs de reconciliación (1.8) ──────────────────────────────────
# Corren dentro del proceso (node-cron), siempre desactivados bajo test.
# RECONCILE_JOB_ENABLED=0 los desactiva por completo (default: activos).
RECONCILE_JOB_ENABLED=1
# Minutos de gracia antes de reconsultar un pedido pending_payment con MP
# (evita gastar llamadas a la API de MP en pedidos recién creados). Default: 5.
RECONCILE_STALE_MINUTES=5
# Horas sin pagar antes de cancelar automáticamente un pedido pending_payment
# (2.2 — libera la reserva de stock de 2.1 y el cupón). Misma ventana para
# MercadoPago y transferencia; efectivo y transferencias con comprobante ya
# subido no expiran solos. Default: 48.
ORDER_EXPIRY_HOURS=48

# ── MercadoPago ───────────────────────────────────────────────────
# Obtener en https://www.mercadopago.com.ar/developers/panel/credentials
# TEST credentials para desarrollo, PRODUCTION para producción
# NUNCA poner credenciales reales acá: este archivo es de ejemplo y se versiona.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# MP_WEBHOOK_SECRET: firma secreta del webhook — REQUERIDO en producción.
#   Se genera en el panel de MercadoPago: Tu aplicación → Webhooks → configurar
#   notificación → "Firma secreta". Sin esto, cualquiera puede invocar
#   POST /api/v1/store/webhook/mp con payloads falsos (ver verifyWebhookSignature).
MP_WEBHOOK_SECRET=

# ── AFIP / ARCA — Facturación electrónica (Fase 2) ────────────────
# Certificado y clave privada del web service (WSAA/WSFEv1), en base64.
# Generarlos según la documentación de ARCA (autogestión de certificados) y
# codificarlos con: base64 -w0 archivo.crt / base64 -w0 archivo.key
# Sin esto, sendInvoiceToAfip/sendStoreOrderToAfip/sendCatalogInvoiceToAfip
# fallan (no hay valor por defecto ni modo degradado — falla explícito).
AFIP_CERT_BASE64=
AFIP_KEY_BASE64=
# Además hay que configurar en Settings (panel admin, no acá): afip_enabled,
# afip_environment (homo|prod), afip_punto_venta, afip_concepto_default, y
# el CUIT/condición IVA de la empresa (company_cuit, ya existente).

# ── Google OAuth (registro e inicio de sesión con Google en la tienda) ────────
# Obtener en https://console.cloud.google.com → APIs y servicios → Credenciales
#   1. Crear proyecto → Pantalla de consentimiento (tipo Externo)
#   2. Crear credencial → OAuth 2.0 → Aplicación web
#   3. Agregar origen autorizado: http://localhost:5173 (dev) y el dominio de producción
#   4. Copiar el "ID de cliente" (termina en .apps.googleusercontent.com)
# Uso gratuito y sin límite de solicitudes para autenticación estándar.
# Si se deja vacío, el botón "Continuar con Google" no aparece en la tienda.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ── URLs públicas — REQUERIDO en producción ──────────────────────
# STORE_URL: base de la tienda. Se usa en los links de los emails (verificación,
#   reset, "mis pedidos") y en las back_urls de MercadoPago (éxito/fallo/pendiente).
#   Si no se setea, los emails de producción apuntarían a localhost.
STORE_URL=https://tudominio.com/tienda
# BACKEND_PUBLIC_URL: URL pública del backend. Se usa como notification_url del
#   webhook de MercadoPago. Sin esto, MercadoPago no puede confirmar los pagos.
BACKEND_PUBLIC_URL=https://tu-backend.up.railway.app

# ── ALERTAS OPERATIVAS (condición C7) ────────────────────────────
# Avisan cuando el sistema está VIVO pero fallando (5xx sostenidos). Que el
# sistema se haya CAÍDO no lo puede avisar el propio sistema: para eso está el
# watchdog externo (UptimeRobot). Guía completa en
# documentos/ALERTAS_Y_MONITOREO.md
#
# Si falta la config de un canal, ese canal se omite en silencio: se puede
# arrancar solo con mail y sumar WhatsApp después.
ALERT_EMAIL_TO=tu-mail@ejemplo.com
# WhatsApp vía CallMeBot (gratis). El número va con código de país y sin
# espacios. La apikey se obtiene escribiéndole al bot una sola vez.
CALLMEBOT_PHONE=+549381XXXXXXX
CALLMEBOT_APIKEY=123456
# Ajustes finos (opcionales, con estos valores por defecto):
# ALERT_5XX_THRESHOLD=10          cuántos 5xx disparan la alerta
# ALERT_5XX_WINDOW_MINUTES=5      en qué ventana se cuentan
# ALERT_COOLDOWN_MINUTES=30       silencio entre alertas de la misma clase
# ALERTS_ENABLED=0                apaga todas las alertas sin tocar código
