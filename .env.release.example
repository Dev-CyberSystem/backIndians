# Variables que usan los scripts de release, backup y rollback.
#
# Copiar a `.env.release` (ese archivo NO se commitea) y completar con los
# valores reales. Sólo hace falta en la máquina desde la que se releasea.
#
# Ninguna de estas variables la usa la aplicación en runtime: son exclusivas de
# las herramientas de `scripts/release/`.

# ─── Base de datos de producción ──────────────────────────────────────────────
# Necesaria para `npm run db:backup` y `npm run db:restore -- --target=prod`.
# Es la MISMA variable que usa el entorno `production` de config/sequelize.js.
# Copiala de las variables del proyecto en Railway (la PUBLIC, que resuelve
# desde afuera de la red interna de Railway; la interna sólo funciona adentro).
MYSQL_PUBLIC_URL=mysql://usuario:clave@host:puerto/nombre_de_base

# ─── URLs para verificar qué hay desplegado ───────────────────────────────────
# Las usa `npm run release:status` para comparar lo que hay en producción contra
# lo tageado localmente.
RELEASE_API_URL=https://tu-backend.up.railway.app/health
RELEASE_SYSTEM_URL=https://sistema.indians.com.ar
RELEASE_STORE_URL=https://indians.com.ar

# ─── Binarios de MySQL (opcional) ─────────────────────────────────────────────
# Sólo si `mysqldump`/`mysql` no están en el PATH y no están en las ubicaciones
# habituales de Windows que el script ya conoce.
# MYSQLDUMP_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysqldump.exe
# MYSQL_CLIENT_PATH=C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe
